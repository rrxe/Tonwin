# ===== Supabase =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456:ABC...
BOT_USERNAME=your_bot_username    # اسم المستخدم الفعلي للبوت بدون @
MINI_APP_SHORT_NAME=app         # اسم الـ Mini App من BotFather (/newapp) — مهم لروابط الإحالة
PUBLIC_URL=https://your-domain.com

# ===== الأدمن =====
ADMIN_SECRET=اكتب_كلمة_سر_طويلة
ADMIN_IDS=5845597704            # آيديات الأدمن (فاصلة بينهم) — يتجاوزوا الصيانة والاشتراك الإجباري

# ===== اختياري =====
TZ_OFFSET_HOURS=3               # حدود "اليوم" (3 = بغداد)
SECURITY_SALT=any_random_text
